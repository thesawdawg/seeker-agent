# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.egg
.venv/
venv/
env/

# Databases (user-generated — the compressed template is tracked)
db/pipeline.db
db/conceptnet.db
db/*.db-shm
db/*.db-wal
db/consensus_tokens.json

# Credentials
.env
API.txt

# Runtime artifacts (user-generated per run)
artifacts/*
!artifacts/.gitkeep
logs/*
!logs/.gitkeep
exports/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Web frontend build output (M5)
web/static/*.map

# Skill output (generated by app-design, dogfood, etc.)
app-design-output/
dogfood-output/

# These were tracked before the ignore rules above existed, and .gitignore
# does not untrack. Removed from the index in the review-fix branch; the
# files stay on disk for anyone who already had them.
