# ─── SEEKER — Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values.
# You need ONE working LLM provider. Everything else is optional.

# ─── LLM Providers ────────────────────────────────────────────────────────
#
# Providers are defined in config.json under "llm.providers". Each one reads
# its base_url and api key from the environment variables below, so you can
# change endpoints without editing config.json.
#
# Any OpenAI-compatible endpoint works. The fallback chain (config.json →
# llm.fallback_chain) is tried in order until one answers.
#
# Check what is reachable and how each agent will route:
#   python3 main.py keys

# --- Open-WebUI (default provider) ---
# Your API key: Open-WebUI → Settings → Account → API keys.
# base_url must include the /api prefix; the router appends /chat/completions.
OPENWEBUI_BASE_URL=http://localhost:3000/api
OPENWEBUI_API_KEY=

# --- Ollama (direct, no Open-WebUI in front) ---
# Uses Ollama's OpenAI-compatible /v1 route. The key is ignored but must exist.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Other OpenAI-compatible endpoints ---
# LM Studio:  LMSTUDIO_BASE_URL=http://localhost:1234/v1
# vLLM:       VLLM_BASE_URL=http://localhost:8000/v1
# OpenAI:     OPENAI_API_KEY=sk-...
# OpenRouter: OPENROUTER_API_KEY=sk-or-...

# --- Anthropic (optional — one provider among many) ---
# Also enables Grounder's web-search source, which uses Anthropic's
# server-side web_search tool. Leave blank to skip that source entirely.
# ANTHROPIC_API_KEY=

# Set the model each provider uses for the "primary" and "light" roles in
# config.json → llm.providers.<name>.models. Agents pick a role; heavy
# reasoning agents use primary, Social and Scribe use light.

# ─── Web Interface ────────────────────────────────────────────────────────
# Only needed when running the HTTP API / web UI. The CLI ignores these.

# REQUIRED to run the web app: encrypts users' stored provider API keys.
# Those keys unlock the user's own provider account, so we refuse to store
# them without this rather than falling back to plaintext.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SEEKER_SECRET_KEY=

# MySQL — the multi-user backend. Unset means SQLite.
# MYSQL_URL=mysql://seeker:secret@localhost:3306/seeker

# Redis — sessions and cache. Unset means in-process sessions,
# which only works with a single web process.
# REDIS_URL=redis://localhost:6379/0

# Session lifetime in seconds (default 86400 = 24h)
# SEEKER_SESSION_TTL=86400

# Comma-separated origins, only if the frontend is served from another host.
# The bundled UI is same-origin, so this is usually left unset.
# SEEKER_CORS_ORIGINS=https://research.example.edu

# ─── Shared-deployment hardening ──────────────────────────────────────────
# The four settings below only matter once more than one person can reach
# the web app. On a single-researcher install the defaults are what you want.

# Where users' provider endpoints may point.
#
# SEEKER runs against local providers by default (Open-WebUI on
# localhost:3000, Ollama on localhost:11434), so private and loopback
# addresses are permitted. But the login endpoint is unauthenticated and
# makes the server fetch whatever URL it is given — on a deployment other
# people can reach, that is a way to probe your internal network.
#
# Set this to 0 on any shared deployment. Cloud metadata and link-local
# addresses (169.254.0.0/16) are refused either way.
# SEEKER_PROVIDER_ALLOW_PRIVATE=0

# Stricter still: only these hosts may be used as provider endpoints.
# Shell-style globs, comma separated. Empty means "anything else allowed".
# SEEKER_PROVIDER_ALLOWLIST=api.openai.com,*.llm.corp.example

# Sign-in attempts allowed per client address per window.
# SEEKER_LOGIN_MAX_ATTEMPTS=10
# SEEKER_LOGIN_WINDOW_SECONDS=60

# Admin (the operator who can edit config.json through the web UI).
#
# By default, if exactly one account exists and none is an admin, that
# account is promoted — the single-researcher case. With more than one
# account SEEKER refuses to guess and you must name the admin here.
# Set SEEKER_AUTO_PROMOTE_FIRST_USER=0 to disable the convenience entirely.
# SEEKER_ADMIN_USER_ID=USR-XXXXXXXX
# SEEKER_AUTO_PROMOTE_FIRST_USER=0

# ─── Academic Source APIs ──────────────────────────────────────────────────

# OpenAlex (free, no key needed for basic use)
# For polite pool (faster): add your email
# OPENALEX_EMAIL=you@university.edu

# Semantic Scholar (free, no key needed)
# For higher rate limits: https://www.semanticscholar.org/product/api
# S2_API_KEY=

# Scopus (requires institutional access)
# Key: https://dev.elsevier.com/
# SCOPUS_API_KEY=
# SCOPUS_INST_TOKEN=

# ─── Consensus (MCP OAuth — no API key needed) ────────────────────────────
# Consensus uses OAuth 2.1 via MCP. On first run, a browser window opens
# for you to log in with your Consensus account. Tokens are saved to
# db/consensus_tokens.json and reused automatically.
# Pro plan gives 20 results/search, 1000 searches/month.
# Disabled by default in config.json — enable in agent_sources to use.
