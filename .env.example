# ─── SEEKER — Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values.
# You need ONE working LLM provider. Everything else is optional.

# ─── LLM Providers ────────────────────────────────────────────────────────
#
# Providers are defined in config.json under "llm.providers". Each one reads
# its base_url and api key from the environment variables below, so you can
# change endpoints without editing config.json.
#
# Any OpenAI-compatible endpoint works. The fallback chain (config.json →
# llm.fallback_chain) is tried in order until one answers.
#
# Check what is reachable and how each agent will route:
#   python3 main.py keys

# --- Open-WebUI (default provider) ---
# Your API key: Open-WebUI → Settings → Account → API keys.
# base_url must include the /api prefix; the router appends /chat/completions.
OPENWEBUI_BASE_URL=http://localhost:3000/api
OPENWEBUI_API_KEY=

# --- Ollama (direct, no Open-WebUI in front) ---
# Uses Ollama's OpenAI-compatible /v1 route. The key is ignored but must exist.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Other OpenAI-compatible endpoints ---
# LM Studio:  LMSTUDIO_BASE_URL=http://localhost:1234/v1
# vLLM:       VLLM_BASE_URL=http://localhost:8000/v1
# OpenAI:     OPENAI_API_KEY=sk-...
# OpenRouter: OPENROUTER_API_KEY=sk-or-...

# --- Anthropic (optional — one provider among many) ---
# Also enables Grounder's web-search source, which uses Anthropic's
# server-side web_search tool. Leave blank to skip that source entirely.
# ANTHROPIC_API_KEY=

# Set the model each provider uses for the "primary" and "light" roles in
# config.json → llm.providers.<name>.models. Agents pick a role; heavy
# reasoning agents use primary, Social and Scribe use light.

# ─── Academic Source APIs ──────────────────────────────────────────────────

# OpenAlex (free, no key needed for basic use)
# For polite pool (faster): add your email
# OPENALEX_EMAIL=you@university.edu

# Semantic Scholar (free, no key needed)
# For higher rate limits: https://www.semanticscholar.org/product/api
# S2_API_KEY=

# Scopus (requires institutional access)
# Key: https://dev.elsevier.com/
# SCOPUS_API_KEY=
# SCOPUS_INST_TOKEN=

# ─── Consensus (MCP OAuth — no API key needed) ────────────────────────────
# Consensus uses OAuth 2.1 via MCP. On first run, a browser window opens
# for you to log in with your Consensus account. Tokens are saved to
# db/consensus_tokens.json and reused automatically.
# Pro plan gives 20 results/search, 1000 searches/month.
# Disabled by default in config.json — enable in agent_sources to use.
